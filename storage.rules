rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Imagens das páginas de Bio (avatar, banner, fundo, blocos de imagem)
    // Leitura pública para renderizar a página; escrita apenas pelo dono.
    match /bioImages/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
