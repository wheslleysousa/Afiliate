rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Dados privados de cada usuário (chaves, produtos salvos, referências mineiradas, stats)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{allChildren=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Marketplace Global — qualquer usuário autenticado pode ler e criar/atualizar produtos
    match /products/{productId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && 'miners' in request.resource.data
        && request.resource.data.miners is list
        && request.auth.uid in request.resource.data.miners
        && (!('miners' in resource.data) || request.resource.data.miners.hasAll(resource.data.miners));

      // Histórico de preço — qualquer usuário autenticado pode ler; somente criar (não editar)
      match /priceHistory/{historyId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update, delete: if false;
      }
    }
    match /shortLinks/{slug} {
      // Leitura pública necessária para resolução de links encurtados
      allow read: if true;
      // Criação permitida para usuários autenticados garantindo o vínculo de propriedade
      allow create: if request.auth != null && (
        !('ownerUid' in request.resource.data) ||
        request.resource.data.ownerUid == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      );
      // Atualização e exclusão estritamente restritas ao dono do link encurtado
      allow update, delete: if request.auth != null && (
        (resource.data.ownerUid != null && resource.data.ownerUid == request.auth.uid) ||
        (resource.data.userId != null && resource.data.userId == request.auth.uid) ||
        (resource.data.createdBy != null && resource.data.createdBy == request.auth.uid)
      );
    }
  }
}
