# ------------------------------------------------------------------------------
# CONFIGURAÇÕES DO WORKER WHATSAPP - AFILIATE
# ------------------------------------------------------------------------------

# UID do Usuário no Afiliate App (OBRIGATÓRIO)
# Exemplo: 06286741-5088-42ae-9702-cf4c78eb1a07 ou seu UID do Firebase Auth
USER_UID=seu_uid_do_firebase_aqui

# Caminho para o arquivo da chave Service Account do Firebase Admin SDK
# Baixe no Firebase Console > Configurações do Projeto > Contas de Serviço > Gerar nova chave privada
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# (Alternativo) Chave JSON em formato de string serializada
# Utile em servicos como Render, Railway ou Heroku para nao precisar de arquivo em disco
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'

# ID do Banco de Dados Firestore (se for banco nomeado)
FIRESTORE_DATABASE_ID=ai-studio-afiliate-06286741-5088-42ae-9702-cf4c78eb1a07

# Pasta para salvar a sessao/autenticacao do WhatsApp Baileys em disco
AUTH_DIR=./auth

# Intervalo de sincronizacao da lista de grupos do WhatsApp (em minutos)
SYNC_GROUPS_INTERVAL_MIN=15

# Intervalo de checagem e disparo de campanhas (em minutos)
CAMPAIGN_CYCLE_INTERVAL_MIN=1

# Use false até validar conta, grupos e campanhas. true ativa envios reais!
WA_SEND_ENABLED=false
# Envio de imagem + legenda a canais: experimental, habilitar só após teste.
# Quando true, falta ou falha de imagem não vira postagem só de texto.
WA_CHANNEL_MEDIA_ENABLED=false
# Controles para teste de 1 postagem, sem criar lotes novos.
WA_DISABLE_CAMPAIGN_GENERATION=false
WA_SEND_TEST_MAX_ATTEMPTS=0
# Criação de grupos/comunidades continua bloqueada por padrão.
WA_GROUP_COMMANDS_ENABLED=false
# Permissão independente para sair de grupos individualmente, mediante confirmação no app.
# O script start-termux-safe.sh habilita apenas esta opção no Termux.
WA_GROUP_LEAVE_ENABLED=false
# Para permitir deixar de seguir canais com confirmação (requer newsletterUnfollow no Baileys).
WA_CHANNEL_LEAVE_ENABLED=false
# (Opcional) Para parear no mesmo Android pelo código do WhatsApp:
# WA_PAIRING_PHONE=55DDDNUMERO
# Não enviar ofertas cujo horário agendado passou há mais de 3 horas.
WA_MAX_QUEUE_AGE_MIN=180

# SUPERVISOR MULTIUSUÁRIO EM SERVIDOR (piloto, sem envio)
# Usar SOMENTE em servidor confiável, não distribuir chave no APK.
# WA_MULTIUSER_AUTH_ROOT=./auth-users
# WA_MAX_MANAGED_USERS=100
# WA_MAX_RUNNING_WORKERS=20
