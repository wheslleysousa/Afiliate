# ------------------------------------------------------------------------------
# CONFIGURAÇÕES DO WORKER WHATSAPP - AFILIATE
# ------------------------------------------------------------------------------

# UID do Usuário no Afiliate App (OBRIGATÓRIO)
# Exemplo: 06286741-5088-42ae-9702-cf4c78eb1a07 ou seu UID do Firebase Auth
USER_UID=seu_uid_do_firebase_aqui

# Caminho para o arquivo da chave Service Account do Firebase Admin SDK
# Baixe no Firebase Console > Configurações do Projeto > Contas de Serviço > Gerar nova chave privada
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# (Alternativo) Chave JSON em formato de string serializada
# Utile em servicos como Render, Railway ou Heroku para nao precisar de arquivo em disco
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'

# ID do Banco de Dados Firestore (se for banco nomeado)
FIRESTORE_DATABASE_ID=ai-studio-afiliate-06286741-5088-42ae-9702-cf4c78eb1a07

# Pasta para salvar a sessao/autenticacao do WhatsApp Baileys em disco
AUTH_DIR=./auth

# Intervalo de sincronizacao da lista de grupos do WhatsApp (em minutos)
SYNC_GROUPS_INTERVAL_MIN=15

# Intervalo de checagem e disparo de campanhas (em minutos)
CAMPAIGN_CYCLE_INTERVAL_MIN=1
